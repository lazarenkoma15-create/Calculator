<Window x:Class="calculator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="460"
        MinHeight="620"
        Title="Калькулятор"
        Height="680"
        Width="520"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        mc:Ignorable="d">
    <!-- Настройки нестандартной рамки сохраняют перетаскивание и изменение размера окна. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="70"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Корневой контейнер размещает единственную карточку калькулятора. -->
    <Grid>
        <!-- Основная визуальная поверхность окна со скруглением и внешней тенью. -->
        <Border Margin="26,22"
                Padding="12"
                CornerRadius="24"
                Background="{StaticResource WindowSurface}"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1.5"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <!-- Строки заголовка, дисплея и клавиатуры калькулятора. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Пользовательская панель заголовка поддерживает перетаскивание окна. -->
                <Grid Grid.Row="0"
                      Margin="4,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <!-- Декоративные цветные индикаторы в левой части заголовка. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="6,0"
                                 Fill="#FF675B" />
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="6,0"
                                 Fill="#FFBD42" />
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="6,0"
                                 Fill="#3BCB78" />
                    </StackPanel>

                    <!-- Системные команды управления состоянием окна. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Сворачивает окно в панель задач. -->
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Content="—"
                                ToolTip="Свернуть"
                                Click="MinimizeButton_Click" />

                        <!-- Переключает обычный и развёрнутый режимы окна. -->
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Content="□"
                                ToolTip="Развернуть"
                                Click="MaximizeButton_Click" />

                        <!-- Закрывает окно и завершает работу калькулятора. -->
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Content="×"
                                FontSize="24"
                                ToolTip="Закрыть"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Дисплей показывает текущее значение из модели представления. -->
                <Border Grid.Row="1"
                        Margin="0,0,0,7"
                        Padding="20,14"
                        CornerRadius="17"
                        Background="{StaticResource DisplaySurface}"
                        BorderBrush="{StaticResource DisplayBorderBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <!-- Длинное значение при необходимости сокращается многоточием. -->
                    <TextBlock Text="{Binding Display}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="58"
                               FontWeight="Light" />
                </Border>

                <!-- Клавиатура передаёт символ каждой клавиши в единую команду ввода. -->
                <Grid Grid.Row="2"
                      Margin="-5,4,-5,-5">
                    <!-- Четыре равные колонки формируют сетку клавиш. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Пять равных строк сохраняют одинаковую высоту клавиш. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Служебная строка: очистка, знак, проценты и деление. -->
                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Content="AC"
                            Command="{Binding InputCommand}"
                            CommandParameter="AC"
                            Style="{StaticResource OperatorButtonStyle}" />
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="+/−"
                            Command="{Binding InputCommand}"
                            CommandParameter="+/-"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="%"
                            Command="{Binding InputCommand}"
                            CommandParameter="%"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="0"
                            Grid.Column="3"
                            Content="÷"
                            Command="{Binding InputCommand}"
                            CommandParameter="/"
                            Style="{StaticResource OperatorButtonStyle}" />

                    <!-- Верхний цифровой ряд и операция умножения. -->
                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Content="7"
                            Command="{Binding InputCommand}"
                            CommandParameter="7"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="8"
                            Command="{Binding InputCommand}"
                            CommandParameter="8"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="9"
                            Command="{Binding InputCommand}"
                            CommandParameter="9"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="3"
                            Content="×"
                            Command="{Binding InputCommand}"
                            CommandParameter="*"
                            Style="{StaticResource OperatorButtonStyle}" />

                    <!-- Средний цифровой ряд и операция вычитания. -->
                    <Button Grid.Row="2"
                            Grid.Column="0"
                            Content="4"
                            Command="{Binding InputCommand}"
                            CommandParameter="4"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="2"
                            Grid.Column="1"
                            Content="5"
                            Command="{Binding InputCommand}"
                            CommandParameter="5"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="6"
                            Command="{Binding InputCommand}"
                            CommandParameter="6"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="2"
                            Grid.Column="3"
                            Content="−"
                            Command="{Binding InputCommand}"
                            CommandParameter="-"
                            Style="{StaticResource OperatorButtonStyle}" />

                    <!-- Нижний цифровой ряд и операция сложения. -->
                    <Button Grid.Row="3"
                            Grid.Column="0"
                            Content="1"
                            Command="{Binding InputCommand}"
                            CommandParameter="1"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="3"
                            Grid.Column="1"
                            Content="2"
                            Command="{Binding InputCommand}"
                            CommandParameter="2"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            Content="3"
                            Command="{Binding InputCommand}"
                            CommandParameter="3"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="3"
                            Grid.Column="3"
                            Content="+"
                            Command="{Binding InputCommand}"
                            CommandParameter="+"
                            Style="{StaticResource OperatorButtonStyle}" />

                    <!-- Финальный ряд: ноль, десятичный разделитель и результат. -->
                    <Button Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Content="0"
                            Command="{Binding InputCommand}"
                            CommandParameter="0"
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="4"
                            Grid.Column="2"
                            Content=","
                            Command="{Binding InputCommand}"
                            CommandParameter=","
                            Style="{StaticResource CalculatorButtonStyle}" />
                    <Button Grid.Row="4"
                            Grid.Column="3"
                            Content="="
                            Command="{Binding InputCommand}"
                            CommandParameter="="
                            Style="{StaticResource EqualButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
