<Project Sdk="Microsoft.NET.Sdk">
  <!-- Настройки автономного консольного проекта с тестами доменного слоя. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Тесты компилируются отдельно и используют основной проект как библиотеку. -->
  <ItemGroup>
    <Compile Include="CalculatorEngineTests.cs" />
    <ProjectReference Include="..\calculator.csproj" />
  </ItemGroup>
</Project>
