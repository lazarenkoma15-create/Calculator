<Application x:Class="calculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Общий словарь ресурсов, доступных во всех окнах приложения. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Цветовая палитра, кисти, градиенты и эффекты теней. -->
                <ResourceDictionary Source="Resources/Colors.xaml" />

                <!-- Переиспользуемые стили кнопок калькулятора и окна. -->
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
