<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Базовые цвета текста и границ интерфейса. -->

    <!-- Основной цвет текста и цифр. -->
    <Color x:Key="TextColor">#26324C</Color>

    <!-- Акцентный цвет символов арифметических операций. -->
    <Color x:Key="OperatorTextColor">#6557EF</Color>

    <!-- Цвет внешней границы окна. -->
    <Color x:Key="WindowBorderColor">#F9FBFF</Color>

    <!-- Цвет границы экрана калькулятора. -->
    <Color x:Key="DisplayBorderColor">#DDE3F0</Color>

    <!-- Цвет границы кнопок арифметических операций. -->
    <Color x:Key="OperatorBorderColor">#D6D0FF</Color>

    <!-- Цвет границы акцентной кнопки результата. -->
    <Color x:Key="EqualBorderColor">#9B8CFF</Color>

    <!-- Кисти связывают палитру со свойствами элементов управления. -->
    <SolidColorBrush x:Key="TextBrush"
                     Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="OperatorTextBrush"
                     Color="{StaticResource OperatorTextColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush"
                     Color="{StaticResource WindowBorderColor}" />
    <SolidColorBrush x:Key="DisplayBorderBrush"
                     Color="{StaticResource DisplayBorderColor}" />
    <SolidColorBrush x:Key="OperatorBorderBrush"
                     Color="{StaticResource OperatorBorderColor}" />
    <SolidColorBrush x:Key="EqualBorderBrush"
                     Color="{StaticResource EqualBorderColor}" />

    <!-- Мягкий фон основной поверхности окна. -->
    <LinearGradientBrush x:Key="WindowSurface"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#FAFBFF" Offset="0" />
        <GradientStop Color="#F2F5FD" Offset="0.55" />
        <GradientStop Color="#EDF1FA" Offset="1" />
    </LinearGradientBrush>

    <!-- Отдельный фон области с текущим значением. -->
    <LinearGradientBrush x:Key="DisplaySurface"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#FCFDFF" Offset="0" />
        <GradientStop Color="#F4F7FC" Offset="0.55" />
        <GradientStop Color="#EEF2FA" Offset="1" />
    </LinearGradientBrush>

    <!-- Нейтральный фон цифровых и служебных клавиш. -->
    <LinearGradientBrush x:Key="KeySurface"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F4F6FB" Offset="1" />
    </LinearGradientBrush>

    <!-- Акцентный фон клавиш арифметических операций. -->
    <LinearGradientBrush x:Key="OperatorSurface"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#F9F8FF" Offset="0" />
        <GradientStop Color="#EEEAFE" Offset="1" />
    </LinearGradientBrush>

    <!-- Насыщенный фон основной кнопки вычисления результата. -->
    <LinearGradientBrush x:Key="EqualSurface"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#8B70FF" Offset="0" />
        <GradientStop Color="#6256EF" Offset="0.58" />
        <GradientStop Color="#7367F5" Offset="1" />
    </LinearGradientBrush>

    <!-- Тень отделяет карточку калькулятора от прозрачного фона окна. -->
    <DropShadowEffect x:Key="WindowShadow"
                      BlurRadius="32"
                      Direction="270"
                      ShadowDepth="12"
                      Color="#526285"
                      Opacity="0.28" />

    <!-- Более лёгкая тень подчёркивает дисплей и обычные клавиши. -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="6"
                      Color="#8794B7"
                      Opacity="0.20" />
</ResourceDictionary>
